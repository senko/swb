(() => { let it = [1, 2, 3].values(); const h = it.map(x => x); const g = it.map(x => x); return [h.next().value, g.next().value, h.next().value] })() => ok [1,2,3]
(() => { let n = 0; const o = {__proto__: Iterator.prototype, next() { return {done: n >= 5, value: n++} }}; const [a, ...rest] = o.map(x => x * x); return [a, rest] })() => ok [0,[1,4,9,16]]
(() => { let n = 0; const o = {__proto__: Iterator.prototype, next() { return {done: n >= 5, value: n++} }}; return Math.max(...o.filter(x => x % 2)) })() => ok 3
(() => { let n = 0; const o = {__proto__: Iterator.prototype, next() { return {done: n >= 5, value: n++} }}; return new Set(o.map(x => x % 2)).size })() => ok 2
(() => { let n = 0; const o = {__proto__: Iterator.prototype, next() { return {done: n >= 5, value: n++} }}; return Object.fromEntries(o.map(x => ['k' + x, x])) })() => ok {k0:0,k1:1,k2:2,k3:3,k4:4}
(() => { let n = 0; const o = {__proto__: Iterator.prototype, next() { return {done: n >= 5, value: [n, n++]} }}; return new Map(o).size })() => ok 5
(() => { let n = 0; const o = {__proto__: Iterator.prototype, next() { return {done: n >= 5, value: n++} }}; return Array.from(o.map(x => x * 2), x => x + 1) })() => ok [1,3,5,7,9]
(() => { const h = [1, 2, 3].values().map(x => x); return [Object.keys(h), Object.getOwnPropertyNames(h), JSON.stringify(h), typeof h.next, h.hasOwnProperty('next')] })() => ok [[],[],"{}","function",false]
(() => { const h = [1, 2, 3].values().map(x => x); h.extra = 1; h.next = 5; return [h.extra, typeof h.next] })() => ok [1,"number"]
(() => { const h = [1, 2, 3].values().map(x => x); return Object.isExtensible(h) && Object.isFrozen(Object.freeze(h)) })() => ok true
