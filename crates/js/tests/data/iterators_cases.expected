(() => { const log = []; const h = [1, 2, 3].values().map(x => { log.push(x); return x }); h.next(); h.next(); h.return(); h.next(); return log })() => ok [1,2]
(() => { const log = []; const h = [1, 2, 3].values().map(x => { log.push(x); if (x == 2) throw 'boom'; return x }); h.next(); try { h.next() } catch (e) { log.push(e) } log.push(h.next().done); return log })() => ok [1,2,"boom",true]
(() => { const log = []; const h = [1, 2, 3].values().filter(x => { log.push(x); if (x == 2) throw 'boom'; return true }); try { h.toArray() } catch (e) { log.push(e) } return log })() => ok [1,2,"boom"]
(() => { const h = [1, 2, 3].values().filter(x => { throw 'boom' }); try { h.next() } catch (e) { return [e, h.next()] } })() => ok ["boom",{value:undefined,done:true}]
(() => { const h = [1, 2, 3].values().take(2); return [h.next().value, h.next().value, h.next().done, h.next().done] })() => ok [1,2,true,true]
(() => { const h = [1, 2, 3].values().drop(2); return [h.next().value, h.next().done] })() => ok [3,true]
(() => { const h = [1, 2, 3].values().drop(0); return h.toArray() })() => ok [1,2,3]
