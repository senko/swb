(() => { const log = []; const it = {__proto__: Iterator.prototype, next() { return {done: false, value: 1} }, return() { log.push('r'); return {} }}; it.take(3).toArray(); it.take(0).next(); const t = it.take(1); t.next(); t.next(); t.next(); return log })() => ok ["r","r","r"]
(() => { const o = {[Symbol.iterator]() { return {next() { return {done: true} }} }}; return Iterator.from(o).toArray() })() => ok []
