[1, 7, 30, 59, 60, 3600, 86400, 86400 * 7, 86400 * 31, 86400 * 400].map(s => { var u = s < 60 ? 'second' : s < 3600 ? 'minute' : s < 86400 ? 'hour' : s < 86400 * 7 ? 'day' : s < 86400 * 30 ? 'week' : s < 86400 * 365 ? 'month' : 'year'; var d = {second: 1, minute: 60, hour: 3600, day: 86400, week: 86400 * 7, month: 86400 * 30, year: 86400 * 365}[u]; return new Intl.RelativeTimeFormat('en-US', {numeric: 'auto', style: 'long'}).format(-Math.round(s / d), u); }).join(' | ') => ok "1 second ago | 7 seconds ago | 30 seconds ago | 59 seconds ago | 1 minute ago | 1 hour ago | yesterday | last week | last month | last year"
[1, 7, 30, 59, 60, 3600, 86400, 86400 * 7, 86400 * 31, 86400 * 400].map(s => { var u = s < 60 ? 'second' : s < 3600 ? 'minute' : s < 86400 ? 'hour' : s < 86400 * 7 ? 'day' : s < 86400 * 30 ? 'week' : s < 86400 * 365 ? 'month' : 'year'; var d = {second: 1, minute: 60, hour: 3600, day: 86400, week: 86400 * 7, month: 86400 * 30, year: 86400 * 365}[u]; return new Intl.RelativeTimeFormat('en-US', {numeric: 'always', style: 'short'}).format(Math.round(s / d), u); }).join(' | ') => ok "in 1 sec. | in 7 sec. | in 30 sec. | in 59 sec. | in 1 min. | in 1 hr. | in 1 day | in 1 wk. | in 1 mo. | in 1 yr."
