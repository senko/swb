(() => { const m = new Map(); for (let i = 0; i < 5000; i++) m.set(i, i); for (let i = 0; i < 5000; i += 3) m.delete(i); let s = 0; for (const [k, v] of m) s += v; return [m.size, s] })() => ok [3333,8331667]
(() => { const m = new Map(); for (let i = 0; i < 3000; i++) m.set("k" + i, i); let s = 0; for (let i = 0; i < 3000; i++) s += m.get("k" + i); return [m.size, s] })() => ok [3000,4498500]
(() => { const s = new Set(); for (let i = 0; i < 4000; i++) { s.add(i); s.add(-i); s.delete(i - 5) } return [s.size, s.has(3999), s.has(-3999), s.has(5)] })() => ok [4002,true,true,false]
(() => { const m = new Map(); const it = m.keys(); for (let i = 0; i < 3000; i++) { m.set(i, i); if (i > 5) m.delete(i - 5) } return [m.size, [...it].length] })() => ok [6,6]
(() => { const m = new Map(); for (let i = 0; i < 2000; i++) m.set(i, i); const its = []; for (let k = 0; k < 20; k++) { const it = m.keys(); for (let j = 0; j < k * 90; j++) it.next(); its.push(it) } for (let r = 0; r < 5; r++) { for (let i = 0; i < 2000; i++) m.delete(i); for (let i = 0; i < 2000; i++) m.set(i + 10000 * (r + 1), i) } return its.map(it => it.next().value).join() })() => ok "10000,10000,10000,10000,10000,10000,10000,10000,10000,10000,10000,10000,10000,10000,10000,10000,10000,10000,10000,10000"
(() => { const a = new Set(), b = new Set(); for (let i = 0; i < 3000; i++) { a.add(i); b.add(i * 2) } return [a.union(b).size, a.intersection(b).size, a.difference(b).size, a.symmetricDifference(b).size, a.isSubsetOf(b), a.isDisjointFrom(b)] })() => ok [4500,1500,1500,3000,false,false]
