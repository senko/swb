const m = new WeakMap(); const keys = []; for (let i = 0; i < 200000; i++) { const k = {}; keys.push(k); m.set(k, i); } let s = 0; for (let i = 0; i < keys.length; i += 1000) s += m.get(keys[i]); s => ok 19900000
const m = new WeakMap(); for (let i = 0; i < 300000; i++) m.set({}, i); 'done' => ok "done"
const s = new WeakSet(); for (let i = 0; i < 300000; i++) s.add({}); 'done' => ok "done"
const fr = new FinalizationRegistry(() => {}); for (let i = 0; i < 100000; i++) fr.register({}, i); 'done' => ok "done"
const fr = new FinalizationRegistry(() => {}); const ts = []; for (let i = 0; i < 50000; i++) { const t = {}; ts.push(t); fr.register({}, i, t); } let n = 0; for (const t of ts) n += fr.unregister(t); n => ok 50000
const rs = []; for (let i = 0; i < 100000; i++) rs.push(new WeakRef({ i })); rs.filter(r => r.deref() !== undefined).length => ok 100000
const m = new WeakMap(); let k = {}; const first = k; for (let i = 0; i < 100000; i++) { const next = {}; m.set(k, next); k = next; } let n = 0; for (let c = first; m.has(c); c = m.get(c)) n++; n => ok 100000
