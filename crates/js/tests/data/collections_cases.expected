(() => { const s = new Set([1, 2]); const r = s.union(new Set([3])); return [r !== s, r instanceof Set, Object.getPrototypeOf(r) === Set.prototype, s.size, r.size] })() => ok [true,true,true,2,3]
(() => { class S extends Set {} const r = new S([1]).union(new Set([2])); return [r instanceof S, r.constructor === Set] })() => ok [false,true]
(() => { class S extends Set { static get [Symbol.species]() { throw new Error("species") } } return new S([1]).union(new Set([2])).size })() => ok 2
(() => { const a = new Set([1, 2, 3]); return [a.union(a).size, a.intersection(a).size, a.difference(a).size, a.symmetricDifference(a).size, a.isSubsetOf(a), a.isSupersetOf(a), a.isDisjointFrom(a)] })() => ok [3,3,0,0,true,true,false]
(() => { const a = new Set([1, 2, 3]); return [[...a.union(a)], [...a.intersection(a)], [...a.difference(a)], [...a.symmetricDifference(a)]] })() => ok [[1,2,3],[1,2,3],[],[]]
(() => { const a = new Set([1, 2, 3]); const it = a.values(); it.next(); return [[...a.union(new Set([9]))], [...it]] })() => ok [[1,2,3,9],[2,3]]
(() => { const a = new Set([1]); return a.union({size: 1, has() { return false }, keys() { return [2, 2, 1, -0, 0, NaN, NaN][Symbol.iterator]() }}) })() => ok Set{1,2,0,NaN}
