(() => { const m = new Map(); for (let i = 0; i < 100; i++) m.set(i, i); const o = []; m.forEach((v, k) => { o.push(k); if (k === 50) { for (let j = 0; j < 100; j++) m.delete(j); for (let j = 200; j < 205; j++) m.set(j, j) } }); return o.slice(48) })() => ok [48,49,50,200,201,202,203,204]
(() => { const m = new Map(); for (let i = 0; i < 100; i++) m.set(i, i); const o = []; m.forEach((v, k) => { o.push(k); if (k === 50) m.clear(); if (k === 50) for (let j = 300; j < 303; j++) m.set(j, j) }); return o.slice(48) })() => ok [48,49,50,300,301,302]
(() => { const m = new Map([[1, 1], [2, 2]]); const o = []; m.forEach((v, k) => { o.push(k); m.forEach((v2, k2) => { o.push("n" + k2); if (k2 === 1) m.delete(2) }) }); return o })() => ok [1,"n1"]
