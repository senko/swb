(() => { const old = BigInt.prototype.toLocaleString; BigInt.prototype.toLocaleString = function () { return "B"; }; try { return new Int16Array([1,2]).toLocaleString(); } finally { BigInt.prototype.toLocaleString = old; } })() => ok "1,2"
(() => { const old = Number.prototype.toLocaleString; Number.prototype.toLocaleString = function () { throw new RangeError("x"); }; try { return new Int16Array([1,2]).toLocaleString(); } catch (e) { return e.message; } finally { Number.prototype.toLocaleString = old; } })() => ok "x"
