(() => { const log = []; const old = Number.prototype.toLocaleString; Number.prototype.toLocaleString = function (...a) { log.push(typeof this); return "N"; }; try { return [new Uint8ClampedArray([1,2]).toLocaleString(), log.join()].join(); } finally { Number.prototype.toLocaleString = old; } })() => ok "N,N,object,object"
(() => { const old = BigInt.prototype.toLocaleString; BigInt.prototype.toLocaleString = function () { return "B"; }; try { return new Uint8ClampedArray([1,2]).toLocaleString(); } finally { BigInt.prototype.toLocaleString = old; } })() => ok "1,2"
(() => { const old = Number.prototype.toLocaleString; Number.prototype.toLocaleString = function () { throw new RangeError("x"); }; try { return new Uint8ClampedArray([1,2]).toLocaleString(); } catch (e) { return e.message; } finally { Number.prototype.toLocaleString = old; } })() => ok "x"
(() => { const old = Number.prototype.toLocaleString; Number.prototype.toLocaleString = 5; try { return new Uint8ClampedArray([1,2]).toLocaleString(); } catch (e) { return e.message; } finally { Number.prototype.toLocaleString = old; } })() => ok "number 5 is not a function"
(() => { const t = new Uint8ClampedArray([1,2]); t.join = () => "J"; return String(t); })() => ok "J"
(() => { const t = new Uint8ClampedArray([1,2]); t.join = 5; return Object.prototype.toString.call(t) + String(t); })() => ok "[object Uint8ClampedArray][object Uint8ClampedArray]"
(() => { const t = new Uint8ClampedArray([1,2]); return t + "!"; })() => ok "1,2!"
(() => { const log = []; const t = new Uint8ClampedArray([1,2,3,4,5]); t.forEach(function (v, i, o) { log.push(typeof v, i, o === t, this === undefined || this === globalThis); }); return log.join(); })() => ok "number,0,true,true,number,1,true,true,number,2,true,true,number,3,true,true,number,4,true,true"
(() => { const log = []; const t = new Uint8ClampedArray([1,2,3,4,5]); t.forEach(function (v, i, o) { log.push(typeof this); }, "s"); return log.join(); })() => ok "object,object,object,object,object"
(() => { "use strict"; const log = []; const t = new Uint8ClampedArray([1,2,3,4,5]); t.forEach(function () { log.push(this); }, 5); return log.join(); })() => ok "5,5,5,5,5"
