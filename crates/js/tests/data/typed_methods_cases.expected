new Int8Array([1,2,3]).toLocaleString(1, 2) => ok "1,2,3"
(() => { const log = []; const old = Number.prototype.toLocaleString; Number.prototype.toLocaleString = function (...a) { log.push(typeof this); return "N"; }; try { return [new Int8Array([1,2]).toLocaleString(), log.join()].join(); } finally { Number.prototype.toLocaleString = old; } })() => ok "N,N,object,object"
(() => { const old = BigInt.prototype.toLocaleString; BigInt.prototype.toLocaleString = function () { return "B"; }; try { return new Int8Array([1,2]).toLocaleString(); } finally { BigInt.prototype.toLocaleString = old; } })() => ok "1,2"
(() => { const old = Number.prototype.toLocaleString; Number.prototype.toLocaleString = function () { throw new RangeError("x"); }; try { return new Int8Array([1,2]).toLocaleString(); } catch (e) { return e.message; } finally { Number.prototype.toLocaleString = old; } })() => ok "x"
(() => { const old = Number.prototype.toLocaleString; Number.prototype.toLocaleString = 5; try { return new Int8Array([1,2]).toLocaleString(); } catch (e) { return e.message; } finally { Number.prototype.toLocaleString = old; } })() => ok "number 5 is not a function"
(() => { const t = new Int8Array([1,2]); t.join = () => "J"; return String(t); })() => ok "J"
(() => { const t = new Int8Array([1,2]); t.join = 5; return Object.prototype.toString.call(t) + String(t); })() => ok "[object Int8Array][object Int8Array]"
(() => { const t = new Int8Array([1,2]); return t + "!"; })() => ok "1,2!"
(() => { const log = []; const t = new Int8Array([1,2,3,4,5]); t.forEach(function (v, i, o) { log.push(typeof v, i, o === t, this === undefined || this === globalThis); }); return log.join(); })() => ok "number,0,true,true,number,1,true,true,number,2,true,true,number,3,true,true,number,4,true,true"
(() => { const log = []; const t = new Int8Array([1,2,3,4,5]); t.forEach(function (v, i, o) { log.push(typeof this); }, "s"); return log.join(); })() => ok "object,object,object,object,object"
(() => { "use strict"; const log = []; const t = new Int8Array([1,2,3,4,5]); t.forEach(function () { log.push(this); }, 5); return log.join(); })() => ok "5,5,5,5,5"
(() => { "use strict"; const log = []; new Int8Array([1,2,3,4,5]).forEach(function () { log.push(this); }); return log.join(); })() => ok ",,,,"
(() => { const log = []; new Int8Array([1,2,3,4,5]).forEach(() => { log.push(1); return 5; }); return log.length; })() => ok 5
(() => { try { new Int8Array([1,2,3,4,5]).forEach(() => { throw new Error("boom"); }); } catch (e) { return e.message; } })() => ok "boom"
