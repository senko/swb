//
// swb cut the partial Document interface to `hidden` and `visibilityState`
// (feature 8a2 of M8). `onvisibilitychange` is in html.idl with Chromium's
// other document event handlers. Chromium's document also has
// `webkitHidden` and `webkitVisibilityState`, which swb does not have.

enum VisibilityState {
  "hidden", "visible"
};

partial interface Document {
  readonly attribute boolean hidden;
  readonly attribute VisibilityState visibilityState;
};
