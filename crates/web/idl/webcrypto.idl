//
// swb cut this file to `Crypto` without `subtle` (no SubtleCrypto, no
// CryptoKey: feature 8a2 of M8) and to the `crypto` attribute of
// WindowOrWorkerGlobalScope. `randomUUID` is not `[SecureContext]` here:
// swb has no secure-context concept, and Chromium hides it on an insecure
// origin that is not local.

[Exposed=Window]
interface Crypto {
  ArrayBufferView getRandomValues(ArrayBufferView array);
  DOMString randomUUID();
};

partial interface mixin WindowOrWorkerGlobalScope {
  [SameObject] readonly attribute Crypto crypto;
};
