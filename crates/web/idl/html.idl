// Source: HTML Living Standard, https://html.spec.whatwg.org/
// copied on 2026-10-23 (ErrorEvent, PromiseRejectionEvent and
// PageTransitionEvent on 2026-10-24; WindowOrWorkerGlobalScope, TimerHandler,
// Function and VoidFunction on 2026-10-24; DocumentReadyState,
// `readyState`, `currentScript` and HTMLScriptElement on 2026-10-24; the
// document collections, getElementsByName and HTMLTemplateElement on
// 2026-10-24).
//
// Copyright © WHATWG (Apple, Google, Mozilla, Microsoft). The standard is
// licensed under the Creative Commons Attribution 4.0 International
// License; "to the extent portions of it are incorporated into source
// code, such portions in the source code are licensed under the BSD
// 3-Clause License instead" (WHATWG IPR Policy 7.1.1). See
// THIRD_PARTY_NOTICES.md for the license text.
//
// swb cut these IDL blocks to the members that it implements (features 4c2,
// 5a, 5c, 6b and 6c of M8). Window has the members that name windows and its
// document. Document has `readyState`, `title`, `body`, `head`,
// `currentScript`, the document collections and `getElementsByName`.
// HTMLElement has the metadata and user interaction attributes that need
// no layout and no events (`title`, `lang`, `translate`, `dir`, `hidden`,
// `inert`, `accessKey`, `draggable`, `spellcheck`, `autocapitalize`,
// `inputMode`, `enterKeyHint`) and the
// members of HTMLOrSVGElement without `focus` and `blur` (feature
// 6d); it lacks `click`, `innerText`, `outerText`, `contentEditable`,
// `popover`, `attachInternals` and the popover members. No element
// interface has the obsolete members, `validity` and the other constraint
// validation members, `labels`, `files`, `valueAsNumber`, `valueAsDate`,
// the selection members of input and textarea, `form.submit()`,
// `reset()`, `requestSubmit()`, `iframe.contentWindow` and
// `contentDocument`, `canvas.getContext`, the media playback members,
// `dialog.show*`, `meter` and `progress` values, `sheet` and the
// factory function `Audio`. `HTMLImageElement` and `HTMLOptionElement`
// have their `LegacyFactoryFunction` (`Image`, `Option`; feature 6c2). The
// attributes whose prose says "limited to only known values" have swb's
// `[SwbKeywords]` (see the generator). `width` and `height` of
// `img` reflect the content attributes (the standard returns the rendered
// or natural size). Two members are the standard's
// `ReflectSetter` with swb's getter: `tabIndex` and `action`. Other
// members whose getter the standard describes in prose are `[SwbCustom]`
// or have a hand-written getter. The element interfaces keep
// `[HTMLConstructor]`; swb has no custom elements, so the generator emits a
// constructor that throws `Illegal constructor` for it. ErrorEvent, PromiseRejectionEvent and
// PageTransitionEvent are complete; WindowOrWorkerGlobalScope has the
// timers, `queueMicrotask` and `reportError` (feature 5b), and TimerHandler
// has no TrustedScript (swb has no Trusted Types). `Function` lacks its
// [LegacyTreatNonObjectAsNull], which only event handler attributes need.
// The order of the remaining members is the specification's.
//
// Three lines are swb's own: the typedef of WindowProxy (without frames,
// the WindowProxy of a window is the Window object itself, ADR 0028
// section 4), the typedef of HTMLOrSVGScriptElement, which is the union of
// HTMLScriptElement and SVGScriptElement in HTML (swb runs no SVG
// scripts), and `HTMLDocument` (Chromium's interface of every document;
// the standard has none).

typedef Window WindowProxy;
typedef HTMLScriptElement HTMLOrSVGScriptElement;

[Global=Window, Exposed=Window]
interface Window : EventTarget {
  // the current browsing context
  [LegacyUnforgeable] readonly attribute WindowProxy window;
  [Replaceable] readonly attribute WindowProxy self;
  [LegacyUnforgeable] readonly attribute Document document;

  // other browsing contexts
  [Replaceable] readonly attribute WindowProxy frames;
  [Replaceable] readonly attribute unsigned long length;
  [LegacyUnforgeable] readonly attribute WindowProxy? top;
  [Replaceable] readonly attribute WindowProxy? parent;
};

enum DocumentReadyState { "loading", "interactive", "complete" };

partial interface Document {
  // resource metadata management
  readonly attribute DocumentReadyState readyState;

  // DOM tree accessors
  [CEReactions] attribute DOMString title;
  [CEReactions] attribute HTMLElement? body;
  readonly attribute HTMLHeadElement? head;
  readonly attribute HTMLOrSVGScriptElement? currentScript; // classic scripts in a document tree only

  // user interaction
  boolean hasFocus();
};
Document includes GlobalEventHandlers;
Document includes DocumentAndElementEventHandlers;

partial interface Document {
  // https://html.spec.whatwg.org/multipage/dom.html#handler-document-onreadystatechange
  // and the other event handlers of Chromium's Document (see the header).
  attribute EventHandler onreadystatechange;
  attribute EventHandler onvisibilitychange;
  attribute EventHandler onfullscreenchange;
  attribute EventHandler onfullscreenerror;
  attribute EventHandler onpointerlockchange;
  attribute EventHandler onpointerlockerror;
  attribute EventHandler onfreeze;
  attribute EventHandler onresume;
};

// DocumentOrShadowRoot (https://dom.spec.whatwg.org/#documentorshadowroot).
partial interface Document {
  readonly attribute Element? activeElement;
};

partial interface Document {
  // resource metadata management
  readonly attribute USVString referrer;

  // the current browsing context
  readonly attribute WindowProxy? defaultView;
};

partial interface Document {
  // DOM tree accessors
  NodeList getElementsByName(DOMString elementName);

  // special document collections
  [SameObject] readonly attribute HTMLCollection images;
  [SameObject] readonly attribute HTMLCollection embeds;
  [SameObject] readonly attribute HTMLCollection plugins;
  [SameObject] readonly attribute HTMLCollection links;
  [SameObject] readonly attribute HTMLCollection forms;
  [SameObject] readonly attribute HTMLCollection scripts;
  [SameObject] readonly attribute HTMLCollection anchors;
  [SameObject] readonly attribute HTMLCollection applets;
};

// The interface of the elements of a document in the HTML namespace
// (HTML §3.2.8 and the element index): HTMLElement, HTMLUnknownElement
// and one interface for each element that has IDL members. HTMLDocument
// is swb's own line (Chromium's `HTMLDocument` is the interface of every
// document).

[Exposed=Window]
interface HTMLDocument : Document {
};

[Exposed=Window]
interface HTMLElement : Element {
  [HTMLConstructor] constructor();

  // metadata attributes
  [CEReactions, Reflect] attribute DOMString title;
  [CEReactions, Reflect] attribute DOMString lang;
  [CEReactions] attribute boolean translate;
  [CEReactions, Reflect, SwbKeywords="ltr rtl auto"] attribute DOMString dir;

  // user interaction
  [CEReactions] attribute (boolean or unrestricted double or DOMString)? hidden;
  [CEReactions, Reflect] attribute boolean inert;
  [CEReactions, Reflect] attribute DOMString accessKey;
  [CEReactions] attribute boolean draggable;
  [CEReactions] attribute boolean spellcheck;
  undefined click();
  [CEReactions, Reflect, SwbKeywords="= none off=none on=sentences sentences words characters", SwbInvalid="sentences"] attribute DOMString autocapitalize;
  [CEReactions, Reflect, SwbKeywords="none text tel url email numeric decimal search", SwbMissing="", SwbInvalid=""] attribute DOMString inputMode;
  [CEReactions, Reflect, SwbKeywords="enter done go next previous search send", SwbMissing="", SwbInvalid=""] attribute DOMString enterKeyHint;
};
HTMLElement includes HTMLOrSVGElement;
HTMLElement includes GlobalEventHandlers;
HTMLElement includes DocumentAndElementEventHandlers;

[Exposed=Window]
interface HTMLUnknownElement : HTMLElement {
};

interface mixin HTMLOrSVGElement {
  [SameObject] readonly attribute DOMStringMap dataset;
  [Reflect] attribute DOMString nonce;
  [CEReactions, Reflect] attribute boolean autofocus;
  [CEReactions, ReflectSetter] attribute long tabIndex;

  undefined focus(optional FocusOptions options = {});
  undefined blur();
};

dictionary FocusOptions {
  boolean preventScroll = false;
  boolean focusVisible;
};

[Exposed=Window, LegacyOverrideBuiltIns]
interface DOMStringMap {
  getter DOMString (DOMString name);
  [CEReactions] setter undefined (DOMString name, DOMString value);
  [CEReactions] deleter undefined (DOMString name);
};

