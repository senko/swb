// The events of HTML that createEvent() names: SubmitEvent (§4.10.18.6),
// HashChangeEvent (§7.4.6), MessageEvent (§9.3), StorageEvent (Web Storage),
// BeforeUnloadEvent (§7.4.6.3) and DragEvent (§6.11.3). `ports` of
// MessageEvent, `storageArea` and `dataTransfer` use `object` where swb has
// no MessagePort, Storage or DataTransfer. HashChangeEvent has no init
// method, as in Chromium.

[Exposed=Window]
interface SubmitEvent : Event {
  constructor(DOMString type, optional SubmitEventInit eventInitDict = {});

  readonly attribute HTMLElement? submitter;
};

dictionary SubmitEventInit : EventInit {
  HTMLElement? submitter = null;
};

