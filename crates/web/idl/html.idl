// Source: HTML Living Standard, https://html.spec.whatwg.org/
// copied on 2026-10-23 (ErrorEvent, PromiseRejectionEvent and
// PageTransitionEvent on 2026-10-24; WindowOrWorkerGlobalScope, TimerHandler,
// Function and VoidFunction on 2026-10-24; DocumentReadyState,
// `readyState`, `currentScript` and HTMLScriptElement on 2026-10-24).
//
// Copyright © WHATWG (Apple, Google, Mozilla, Microsoft). The standard is
// licensed under the Creative Commons Attribution 4.0 International
// License; "to the extent portions of it are incorporated into source
// code, such portions in the source code are licensed under the BSD
// 3-Clause License instead" (WHATWG IPR Policy 7.1.1). See
// THIRD_PARTY_NOTICES.md for the license text.
//
// swb cut these IDL blocks to the members that it implements (features 4c2
// and 5a of M8): Window has the members that name windows and its document;
// Document has `readyState`, `title`, `body`, `head` and `currentScript`
// (feature 5c); HTMLScriptElement has `src`, `type`, `noModule`, `async`,
// `defer` and `text` (feature 5c), and no constructor; HTMLElement has no members yet
// and no constructor; HTMLHeadElement is complete apart from the
// constructor; ErrorEvent, PromiseRejectionEvent and PageTransitionEvent
// are complete; WindowOrWorkerGlobalScope has the timers, `queueMicrotask`
// and `reportError` (feature 5b), and TimerHandler has no TrustedScript
// (swb has no Trusted Types). `Function` lacks its
// [LegacyTreatNonObjectAsNull], which only event handler attributes
// need. The order of the remaining members is the specification's.
//
// Two lines are swb's own: the typedef of WindowProxy (without frames, the
// WindowProxy of a window is the Window object itself, ADR 0028 section
// 4), and the typedef of HTMLOrSVGScriptElement, which is the union of
// HTMLScriptElement and SVGScriptElement in HTML (swb has no SVG
// interfaces and runs no SVG scripts).

typedef Window WindowProxy;
typedef HTMLScriptElement HTMLOrSVGScriptElement;

[Global=Window, Exposed=Window]
interface Window : EventTarget {
  // the current browsing context
  [LegacyUnforgeable] readonly attribute WindowProxy window;
  [Replaceable] readonly attribute WindowProxy self;
  [LegacyUnforgeable] readonly attribute Document document;

  // other browsing contexts
  [Replaceable] readonly attribute WindowProxy frames;
  [Replaceable] readonly attribute unsigned long length;
  [LegacyUnforgeable] readonly attribute WindowProxy? top;
  [Replaceable] readonly attribute WindowProxy? parent;
};

enum DocumentReadyState { "loading", "interactive", "complete" };

partial interface Document {
  // resource metadata management
  readonly attribute DocumentReadyState readyState;

  // DOM tree accessors
  [CEReactions] attribute DOMString title;
  [CEReactions] attribute HTMLElement? body;
  readonly attribute HTMLHeadElement? head;
  readonly attribute HTMLOrSVGScriptElement? currentScript; // classic scripts in a document tree only
};

partial interface Document {
  // resource metadata management
  readonly attribute USVString referrer;

  // the current browsing context
  readonly attribute WindowProxy? defaultView;
};

[Exposed=Window]
interface HTMLElement : Element {
};
HTMLElement includes HTMLOrSVGElement;

interface mixin HTMLOrSVGElement {
  [SameObject] readonly attribute DOMStringMap dataset;
};

[Exposed=Window, LegacyOverrideBuiltIns]
interface DOMStringMap {
  getter DOMString (DOMString name);
  [CEReactions] setter undefined (DOMString name, DOMString value);
  [CEReactions] deleter undefined (DOMString name);
};

[Exposed=Window]
interface HTMLHeadElement : HTMLElement {
};

[Exposed=Window]
interface HTMLScriptElement : HTMLElement {
  [CEReactions, ReflectURL] attribute USVString src;
  [CEReactions, Reflect] attribute DOMString type;
  [CEReactions, Reflect="nomodule"] attribute boolean noModule;
  [CEReactions] attribute boolean async;
  [CEReactions, Reflect] attribute boolean defer;
  [CEReactions] attribute DOMString text;
};

[Exposed=*]
interface ErrorEvent : Event {
  constructor(DOMString type, optional ErrorEventInit eventInitDict = {});

  readonly attribute DOMString message;
  readonly attribute USVString filename;
  readonly attribute unsigned long lineno;
  readonly attribute unsigned long colno;
  readonly attribute any error;
};

dictionary ErrorEventInit : EventInit {
  DOMString message = "";
  USVString filename = "";
  unsigned long lineno = 0;
  unsigned long colno = 0;
  any error;
};

[Exposed=*]
interface PromiseRejectionEvent : Event {
  constructor(DOMString type, PromiseRejectionEventInit eventInitDict);

  readonly attribute object promise;
  readonly attribute any reason;
};

dictionary PromiseRejectionEventInit : EventInit {
  required object promise;
  any reason;
};

[Exposed=Window]
interface PageTransitionEvent : Event {
  constructor(DOMString type, optional PageTransitionEventInit eventInitDict = {});

  readonly attribute boolean persisted;
};

dictionary PageTransitionEventInit : EventInit {
  boolean persisted = false;
};

typedef (DOMString or Function) TimerHandler;

callback Function = any (any... arguments);
callback VoidFunction = undefined ();

interface mixin WindowOrWorkerGlobalScope {
  // https://html.spec.whatwg.org/multipage/webappapis.html#windoworworkerglobalscope-mixin
  undefined reportError(any e);

  // timers
  long setTimeout(TimerHandler handler, optional long timeout = 0, any... arguments);
  undefined clearTimeout(optional long id = 0);
  long setInterval(TimerHandler handler, optional long timeout = 0, any... arguments);
  undefined clearInterval(optional long id = 0);

  // microtask queuing
  undefined queueMicrotask(VoidFunction callback);
};
Window includes WindowOrWorkerGlobalScope;
