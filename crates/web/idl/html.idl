typedef (DOMString or Function) TimerHandler;

callback Function = any (any... arguments);
callback VoidFunction = undefined ();

interface mixin WindowOrWorkerGlobalScope {
  // https://html.spec.whatwg.org/multipage/webappapis.html#windoworworkerglobalscope-mixin
  undefined reportError(any e);

  // timers
  long setTimeout(TimerHandler handler, optional long timeout = 0, any... arguments);
  undefined clearTimeout(optional long id = 0);
  long setInterval(TimerHandler handler, optional long timeout = 0, any... arguments);
  undefined clearInterval(optional long id = 0);

  // microtask queuing
  undefined queueMicrotask(VoidFunction callback);
};
Window includes WindowOrWorkerGlobalScope;
Window includes GlobalEventHandlers;
Window includes WindowEventHandlers;

// The event handlers (HTML §8.1.8.1, "Event handlers",
// https://html.spec.whatwg.org/multipage/webappapis.html#event-handlers-on-elements,-document-objects,-and-window-objects).
// swb's list is the specification's plus the names that Chromium 148 has on
// HTMLElement.prototype and Window and that pages use (`onmousewheel`,
// `onselectstart`, `onselectionchange`, the CSS animation and transition
// handlers, the pointer handlers of pointer-events.idl), without the touch
// handlers (Chromium has none without touch input; pages test for
// `ontouchstart in window`) and without the Chromium-only names of no use to
// pages. The generator makes the glue of the three handler types itself
// (`EventHandler`, `OnErrorEventHandler`, `OnBeforeUnloadEventHandler`); the
// callback types are the specification's, with `any` for the first argument
// of `OnErrorEventHandlerNonNull` (a union in the specification).

callback EventHandlerNonNull = any (Event event);
typedef EventHandlerNonNull? EventHandler;

callback OnErrorEventHandlerNonNull = any (any event, optional DOMString source, optional unsigned long lineno, optional unsigned long colno, optional any error);
typedef OnErrorEventHandlerNonNull? OnErrorEventHandler;

callback OnBeforeUnloadEventHandlerNonNull = DOMString? (Event event);
typedef OnBeforeUnloadEventHandlerNonNull? OnBeforeUnloadEventHandler;

interface mixin GlobalEventHandlers {
  attribute EventHandler onabort;
  attribute EventHandler onauxclick;
  attribute EventHandler onbeforeinput;
  attribute EventHandler onbeforematch;
  attribute EventHandler onbeforetoggle;
  attribute EventHandler onblur;
