//
// swb cut this file to `Worker` and `WorkerOptions`: the stand-in of M12
// feature 2 (crates/web/src/workers.rs) takes messages and runs no script.
// Departures from the standard that Chromium 148 shares (measured in
// tools/probes/web-osm-gaps.json, case `worker-stand-in`): `Worker` has no
// `onmessageerror`, and the constructor takes a `USVString` where the
// standard says `(TrustedScriptURL or USVString)` (swb has no Trusted Types).
// `SharedWorker` and the worker global scopes are not in swb.

enum WorkerType { "classic", "module" };

dictionary WorkerOptions {
  WorkerType type = "classic";
  RequestCredentials credentials = "same-origin"; // credentials is only used if type is "module"
  DOMString name = "";
};

[Exposed=Window]
interface Worker : EventTarget {
  constructor(USVString scriptURL, optional WorkerOptions options = {});

  undefined terminate();

  undefined postMessage(any message, sequence<object> transfer);
  undefined postMessage(any message, optional StructuredSerializeOptions options = {});

  // AbstractWorker
  attribute EventHandler onerror;

  attribute EventHandler onmessage;
};
