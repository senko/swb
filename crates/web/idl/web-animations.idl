// Sources:
// - Web Animations Level 1, W3C Editor's Draft,
//   https://drafts.csswg.org/web-animations-1/ (§6.4 "The Animation
//   interface", §6.5 "The AnimationEffect interface", §6.6 "The
//   KeyframeEffect interface", §6.7 "The Animatable interface mixin", §6.8
//   "Extensions to the Document interface"), copied on 2026-11-21;
// - CSS Animations Level 2, W3C Editor's Draft,
//   https://drafts.csswg.org/css-animations-2/ (§6.1 "The CSSAnimation
//   interface"), copied on 2026-11-21;
// - Web Animations Level 1 (§6.1 "The AnimationTimeline interface", §6.2
//   "The DocumentTimeline interface"), CSS Transitions Level 2,
//   https://drafts.csswg.org/css-transitions-2/ (§6.1 "The CSSTransition
//   interface"), and CSS Animations Level 1, W3C Working Draft,
//   https://www.w3.org/TR/css-animations-1/ (§5.1 "The AnimationEvent
//   interface"), copied on 2026-11-22.
//
// This file includes material copied from these documents. Copyright © 2026
// World Wide Web Consortium. https://www.w3.org/copyright/software-license-2023/
// (W3C Software and Document License; the full notice is in
// THIRD_PARTY_NOTICES.md).
//
// swb cut and changed this file for features 3b and 3c of M13 (ADR 0044
// section 7). No `animate()`, no constructors of `Animation`,
// `KeyframeEffect`, `AnimationTimeline` and `DocumentTimeline` (the
// interfaces exist for `instanceof`), no `reverse()`,
// `updatePlaybackRate()`, `persist()`, `commitStyles()`, `onfinish`,
// `oncancel`, `onremove`, `updateTiming()`, `setKeyframes()`,
// `AnimationTimeline.duration`. `id`, `timeline` and `effect` are
// read-only; the enums are `DOMString`; `EffectTiming.duration` is a number
// (CSS animations always have one). `CSSTransition` exists for
// `instanceof` (no instance before feature 5).

dictionary EffectTiming {
  double delay = 0;
  double endDelay = 0;
  DOMString fill = "auto";
  double iterationStart = 0.0;
  unrestricted double iterations = 1.0;
  unrestricted double duration = 0;
  DOMString direction = "normal";
  DOMString easing = "linear";
};

dictionary ComputedEffectTiming : EffectTiming {
  unrestricted double endTime = 0;
  unrestricted double activeDuration = 0;
  double? localTime = null;
  double? progress = null;
  unrestricted double? currentIteration = null;
};

[Exposed=Window]
interface AnimationEffect {
  EffectTiming getTiming();
  ComputedEffectTiming getComputedTiming();
};

[Exposed=Window]
interface KeyframeEffect : AnimationEffect {
  readonly attribute Element? target;
  readonly attribute CSSOMString? pseudoElement;
  readonly attribute DOMString composite;
  sequence<object> getKeyframes();
};

[Exposed=Window]
interface AnimationTimeline {
  readonly attribute double? currentTime;
};

[Exposed=Window]
interface DocumentTimeline : AnimationTimeline {
};

[Exposed=Window]
interface Animation : EventTarget {
  readonly attribute DOMString id;
  [SameObject] readonly attribute AnimationEffect? effect;
  readonly attribute AnimationTimeline? timeline;
  attribute double? startTime;
  attribute double? currentTime;
  readonly attribute DOMString playState;
  readonly attribute DOMString replaceState;
  readonly attribute boolean pending;
  readonly attribute Promise<Animation> ready;
  readonly attribute Promise<Animation> finished;
  undefined cancel();
  undefined finish();
  undefined play();
  undefined pause();
};

[Exposed=Window]
interface CSSAnimation : Animation {
  readonly attribute CSSOMString animationName;
};

[Exposed=Window]
interface CSSTransition : Animation {
  readonly attribute CSSOMString transitionProperty;
};

[Exposed=Window]
interface AnimationEvent : Event {
  constructor(CSSOMString type, optional AnimationEventInit animationEventInitDict = {});
  readonly attribute CSSOMString animationName;
  readonly attribute double elapsedTime;
  readonly attribute CSSOMString pseudoElement;
};

dictionary AnimationEventInit : EventInit {
  CSSOMString animationName = "";
  double elapsedTime = 0.0;
  CSSOMString pseudoElement = "";
};

dictionary GetAnimationsOptions {
  boolean subtree = false;
};

partial interface Element {
  sequence<Animation> getAnimations(optional GetAnimationsOptions options = {});
};

partial interface Document {
  readonly attribute DocumentTimeline timeline;
  sequence<Animation> getAnimations();
};
