//
// swb cut this file to DOMParser (feature 6b of M8). The enumeration is
// named SupportedType, as in Chromium's messages (the specification calls
// it DOMParserSupportedType). The members of InnerHTML, outerHTML and
// insertAdjacentHTML are in dom.idl, on Element.

[Exposed=Window]
interface DOMParser {
  constructor();

  [NewObject] Document parseFromString(DOMString string, SupportedType type);
};

enum SupportedType {
  "text/html",
  "text/xml",
  "application/xml",
  "application/xhtml+xml",
  "image/svg+xml"
};
