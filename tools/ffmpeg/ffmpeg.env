# The pins of swb's FFmpeg build (ADR 0047 section 1). The only place that
# names them: tools/ffmpeg/build.sh (`just ffmpeg`), the build script of
# crates/media-ffi and the CI cache key read this file and configure.txt.
#
# Format: KEY=VALUE lines, no quotes, no spaces; `#` starts a comment line.
#
# An update (ADR 0047 section 1, "Updates") changes these values and the
# date of the signature check, then: `just ffmpeg`, `just check-media`, the
# media probe tests, the hostile-page set; one commit.

FFMPEG_VERSION=9.0.2
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e
# The size of the tarball in bytes (checked before the SHA-256).
FFMPEG_SIZE=12040788
FFMPEG_URL=https://ffmpeg.org/releases
# The FFmpeg release signing key (tools/ffmpeg/release-key.asc).
FFMPEG_KEY_FINGERPRINT=FCF986EA15E6E293A5644F10B4322F04D67658D8
# The day the signature of the tarball above was checked against that key.
# Documentation only: the CI cache key does not include this line.
FFMPEG_SIGNATURE_CHECKED=2026-11-24
