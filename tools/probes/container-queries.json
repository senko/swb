  {
   "name": "odd-container-boxes",
   "html": "<!DOCTYPE html><style>body{margin:0;font:16px/20px sans-serif}.c{container-type:inline-size;width:300px} .t{color:rgb(255,0,0)}@container (width >= 0px) { .t{color:rgb(0,128,0)} } @container not (width >= 0px) { .t{color:rgb(0,0,255)} }@container (width >= 0px) { .w{width:10px} }.w{height:2px;width:20px;display:block}</style><div class=c id=none style='display:none'><span class='t w' id=t1>a</span></div><div class=c id=contents style='display:contents'><span class='t w' id=t2>b</span></div><span class=c id=inline><span class='t w' id=t3>c</span></span><table><tr class=c id=tr><td><span class='t w' id=t4>d</span></td></tr><tr><td class=c id=td><span class='t w' id=t5>e</span></td></tr></table><table class=c id=table><tr><td><span class='t w' id=t6>f</span></td></tr></table><div style='container-type:inline-size;width:600px'><span class=c id=inl2><span class='t w' id=t7>g</span></span><div class=c style='display:contents'><span class='t w' id=t8>h</span></div></div><div class=c id=ib style='display:inline-block'><span class='t w' id=t9>i</span></div><div class=c id=flexc style='display:flex'><span class='t w' id=t10>j</span></div><ul><li class=c id=li style='display:list-item'><span class='t w' id=t11>k</span></li></ul><div class=c style='display:inline-flex'><span class='t w' id=t12>l</span></div>",
   "measure": [
    {
     "boxes": ".w"
    },
    {
     "js": "[getComputedStyle(document.querySelector('#t1')).color,getComputedStyle(document.querySelector('#t2')).color,getComputedStyle(document.querySelector('#t3')).color,getComputedStyle(document.querySelector('#t4')).color,getComputedStyle(document.querySelector('#t5')).color,getComputedStyle(document.querySelector('#t6')).color,getComputedStyle(document.querySelector('#t7')).color,getComputedStyle(document.querySelector('#t8')).color,getComputedStyle(document.querySelector('#t9')).color,getComputedStyle(document.querySelector('#t10')).color,getComputedStyle(document.querySelector('#t11')).color,getComputedStyle(document.querySelector('#t12')).color]"
    }
   ]
  },
  {
   "name": "pseudo-elements",
   "html": "<!DOCTYPE html><style>body{margin:0;font:16px/20px sans-serif}#c{container-type:inline-size;width:300px} #c::before{content:'b';color:rgb(255,0,0)}#k{container-type:inline-size;width:100px} #k::before{content:'k';color:rgb(255,0,0)}li.c2{container-type:inline-size;width:150px} li::marker{color:rgb(255,0,0)}@container (width = 150px) { li::marker{color:rgb(0,0,255)} }@container (width = 300px) { #c::before{color:rgb(0,128,0)} #c::after{content:'a';color:rgb(0,128,0)} #k::before{color:rgb(0,128,0)} li::marker{color:rgb(0,128,0)} input::placeholder{color:rgb(0,128,0)} }@container (width = 100px) { #k::before{color:rgb(0,0,255)} #c::after{color:rgb(0,0,255)} }</style><div id=c><div id=k></div><ul><li id=li>x</li><li class=c2 id=li2>y</li></ul><input id=in placeholder=p></div>",
   "measure": [
    {
     "js": "['#c::before','#c::after','#k::before'].map(function(s){var p=s.split('::');return getComputedStyle(document.querySelector(p[0]),'::'+p[1]).color}).concat([getComputedStyle(document.querySelector('#li'),'::marker').color, getComputedStyle(document.querySelector('#li2'),'::marker').color, getComputedStyle(document.querySelector('#in'),'::placeholder').color])"
    },
    {
     "boxes": "#c, #k"
    }
   ]
  },
  {
   "name": "backdrop-under-container",
   "javascript": true,
   "html": "<!DOCTYPE html><style>body{margin:0;font:16px/20px sans-serif}#c{container-type:inline-size;width:300px} dialog{width:50px} dialog::backdrop{background:rgb(255,0,0)}#d{container-type:inline-size} #in{color:rgb(255,0,0)}@container (width = 300px) { dialog::backdrop{background:rgb(0,128,0)} #d{color:rgb(0,128,0)} }@container (width = 50px) { dialog::backdrop{background:rgb(0,0,255)} #in{color:rgb(0,0,255)} }</style><div id=c><dialog id=d><span id=in>x</span></dialog></div><script>document.getElementById('d').showModal()</script>",
   "measure": [
    {
     "js": "[getComputedStyle(document.querySelector('#d'),'::backdrop').backgroundColor, getComputedStyle(document.querySelector('#d')).color, getComputedStyle(document.querySelector('#in')).color]"
    },
