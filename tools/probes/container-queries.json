   "html": "<!DOCTYPE html><style>body{margin:0;font:16px/20px sans-serif}.k{container-type:inline-size;height:30px}.t{height:2px}</style><div id=p style='--w:10cqw'><div class=k style='width:300px'><div class=t id=a style='width:50cqw'></div><div class=t id=b style='width:var(--w)'></div></div><div class=k style='width:200px'><div class=t id=c style='width:var(--w)'></div><div class=t id=d style='width:calc(var(--w) + 1cqw)'></div><div class=t id=e style='width:50cqw;margin-left:1cqw'></div></div></div>",
