  {
   "name": "shadow-flat-tree",
   "javascript": true,
   "html": "<!DOCTYPE html><style>body{margin:0;font:16px/20px sans-serif}.t{height:2px;width:20px} #outer{container:card/inline-size;width:500px}@container (width = 200px) { #s1{width:10px} }@container (width = 500px) { #s2{width:10px} }@container card (width = 500px) { #s3{width:10px} }@container shadowname (width = 200px) { #s4{width:10px} }</style><div id=outer><div id=host><div class=t id=s1></div><div class=t id=s2 slot=x></div><div class=t id=s3></div><div class=t id=s4></div></div></div><script>var r=document.getElementById('host').attachShadow({mode:'open'});r.innerHTML='<style>.box{container:shadowname/inline-size;width:200px} .t{height:2px;width:20px}@container (width = 200px){#i1{width:10px}} @container card (width = 500px){#i2{width:10px}}@container shadowname (width = 200px){#i3{width:10px}} @container (width = 500px){::slotted(#s2){width:5px}}@container (width = 200px){::slotted(#s1){height:4px}} :host{display:block}</style><div class=box id=box><slot></slot><div class=t id=i1></div><div class=t id=i2></div><div class=t id=i3></div></div><slot name=x></slot>';</script>",
   "measure": [
    {
     "boxes": "#outer, #host, .t"
    },
    {
     "js": "(function(){var r=document.getElementById('host').shadowRoot;return ['i1','i2','i3'].map(function(i){return getComputedStyle(r.getElementById(i)).width})})()"
    }
   ]
  },
  {
   "name": "own-size",
