  {
   "name": "containment-layout-effects",
   "html": "<!DOCTYPE html><style>body{margin:0;font:16px/20px sans-serif}.c{container-type:inline-size;background:#eee} p{margin:20px 0;height:10px}</style><div id=a1 class=c><p id=p1>m</p></div><div id=a2 class=c><div id=f1 style='float:left;width:50px;height:60px'></div></div><div id=after2>after float</div><div style='position:relative;margin-top:30px;height:100px' id=rel><div class=c id=a3 style='margin-left:40px'><div id=abs style='position:absolute;top:0;left:0;width:10px;height:10px'></div></div></div><div class=c id=a4 style='margin-top:10px'><div id=fix style='position:fixed;top:0;right:0;width:10px;height:10px'></div></div><div id=a5 class=c style='height:20px'><div id=ov style='height:50px;width:50px'></div></div><div id=a6>next</div><ol id=ol><li class=c id=li1>a</li><li id=li2>b</li></ol>",
   "measure": [
    {
     "boxes": "#a1, #p1, #a2, #f1, #after2, #rel, #a3, #abs, #a4, #fix, #a5, #ov, #a6, #li1, #li2"
