  {
   "name": "query-changes-display",
   "html": "<!DOCTYPE html><style>body{margin:0;font:16px/20px sans-serif}#c{container-type:inline-size;width:500px} .b{height:10px;width:30px}@container (width > 400px) { #hide{display:none} #inl{display:inline-block} #fl{display:flex} #inner{display:none} }#inner{container-type:inline-size;width:100px} @container (width < 200px) { #deep{width:5px} }</style><div id=c><div class=b id=hide></div><div class=b id=inl></div><div class=b id=fl></div><div id=inner><div class=b id=deep></div></div><div class=b id=last></div></div>",
   "measure": [
