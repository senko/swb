  {
   "name": "units-attr-var-script",
   "javascript": true,
   "html": "<!DOCTYPE html><style>body{margin:0;font:16px/20px sans-serif}.k{container-type:inline-size;height:30px}.t{height:2px;width:var(--w)}</style><div id=p><div class=k style='width:300px'><div class=t id=a></div></div><div class=k style='width:200px'><div class=t id=b></div></div></div>",
   "measure": [
    {
     "js": "(function(){var p=document.querySelector('#p'),a=document.querySelector('#a'),b=document.querySelector('#b');var r=[a.getBoundingClientRect().width];p.style.setProperty('--w','10cqw');r.push(a.getBoundingClientRect().width,b.getBoundingClientRect().width,getComputedStyle(a).width);p.style.setProperty('--w','20cqw');r.push(a.getBoundingClientRect().width,b.getBoundingClientRect().width);return r})()"
    },
