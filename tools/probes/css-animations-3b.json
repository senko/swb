   "html": "<!DOCTYPE html><html><head><meta charset=utf-8><style>\n:root{--ease-soft:cubic-bezier(.2,.8,.2,1);--manila:rgb(243,231,210);--black:rgb(31,29,27)}\nbody{margin:0;background:rgb(120,90,150)}\nheader{--hero-title-from:var(--black);position:relative;width:380px;height:240px}\n[data-hero-video]{position:absolute;left:20px;top:10px;width:200px;height:100px;background:rgb(200,0,0);animation:hero-video-in 1.1s var(--ease-soft) var(--hero-delay,.9s) both paused}\n[data-hero-title]{margin:0;position:absolute;left:20px;top:140px;font:bold 40px Arial;text-transform:uppercase;color:var(--manila);animation:hero-title-in 1.1s ease var(--hero-delay,.9s) both paused}\n[data-hero-title-outline]{color:#0000;-webkit-text-stroke:1.5px var(--manila);animation:hero-outline-in 1.1s ease var(--hero-delay,.9s) both paused}\n[data-hero-ready] [data-hero-video],[data-hero-ready] [data-hero-title],[data-hero-ready] [data-hero-title-outline]{animation-play-state:running}\n@keyframes hero-video-in{0%{opacity:0;transform:translateY(12px)scale(.99)}to{opacity:1;transform:none}}\n@keyframes hero-title-in{0%{color:var(--hero-title-from)}to{color:var(--manila)}}\n@keyframes hero-outline-in{0%{-webkit-text-stroke-color:var(--hero-title-from)}to{-webkit-text-stroke-color:var(--manila)}}\n</style></head><body><header data-hero-reveal><div data-hero-video></div><h1 data-hero-title>Open <span data-hero-title-outline>Web</span></h1></header><script>\nconst $ = (s) => document.querySelector(s);\nconst $$ = (s) => [...document.querySelectorAll(s)];\nconst wait = (ms) => new Promise((r) => setTimeout(r, ms));\nfunction E(f) { try { const v = f(); return v === undefined ? 'undefined' : v; } catch (e) { return e.constructor.name + ': ' + e.message; } }\nfunction seek(t) { for (const a of document.getAnimations()) { a.pause(); a.currentTime = t; } }\nfunction val(sel, props) { const cs = getComputedStyle($(sel)); return props.map((p) => p + ':' + cs.getPropertyValue(p)).join(' ; '); }\nfunction at(sel, props, times) { return times.map((t) => { seek(t); return t + ' ' + val(sel, props); }).join('\\n'); }\nfunction atAll(sels, props, times) { return times.map((t) => { seek(t); return t + ' ' + sels.map((s) => s + ' {' + val(s, props) + '}').join(' '); }).join('\\n'); }\nfunction rect(sel) { const r = $(sel).getBoundingClientRect(); return [r.x, r.y, r.width, r.height].map((v) => Math.round(v * 100) / 100).join(','); }\nfunction states() { return document.getAnimations().map((a) => (a.animationName || a.transitionProperty) + ':' + a.playState + ':' + a.currentTime).join(' | '); }\nfunction timing(a) { const c = a.effect.getComputedTiming(); return JSON.stringify({delay: c.delay, endDelay: c.endDelay, fill: c.fill, iterationStart: c.iterationStart, iterations: c.iterations, duration: c.duration, direction: c.direction, easing: c.easing, endTime: c.endTime, activeDuration: c.activeDuration}); }\n\nconst H = $('header');\nconst VID = '[data-hero-video]', TTL = '[data-hero-title]', OUT = '[data-hero-title-outline]';\nfunction ready(delay) { H.style.setProperty('--hero-delay', delay); H.setAttribute('data-hero-ready', ''); }\n</script></body></html>",
