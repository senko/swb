   {"name": "scripting-media-on",
    "html": "<!DOCTYPE html><style>#m { width: 10px; height: 10px } @media (scripting: enabled) { #m { width: 20px } } @media (scripting: none) { #m { width: 30px } }</style><div id=m></div>",
    "measure": [
      {"boxes": "#m"},
      {"js": "matchMedia('(scripting)').matches"},
      {"js": "matchMedia('(scripting: enabled)').matches"}
    ]},
   {"name": "scripting-media-off",
    "javascript": false,
    "html": "<!DOCTYPE html><style>#m { width: 10px; height: 10px } @media (scripting: enabled) { #m { width: 20px } } @media (scripting: none) { #m { width: 30px } }</style><div id=m></div>",
    "measure": [
      {"boxes": "#m"},
      {"js": "matchMedia('(scripting)').matches"}
    ]},
   {"name": "script-changes-the-dom",
