{"viewport": [800, 600],
 "cases": [
  {"name": "gb-fixed-height-rows",
   "html": "<!DOCTYPE html><style>body{margin:0;font:16px/20px Arial}button{display:grid;height:100px;width:200px;padding:0;border:0;grid-template-columns:1fr auto}</style><button id=g><span id=a>text</span><i id=b style='width:10px;height:10px'></i></button><button id=h style='grid-template-rows:20px'><span id=c>text</span><i id=d style='width:10px;height:10px'></i></button>",
   "measure": [{"boxes": "#g, #a, #b, #h, #c, #d"}]},
  {"name": "gb-fixed-height-flex-flow",
