   "measure": [{"boxes": "#g, #a, #b, #h, #c, #k"}, {"rects": "body"}]},
  {"name": "gb-width-auto",
   "html": "<!DOCTYPE html><style>body{margin:0;font:16px/20px Arial}button{display:grid;padding:0;border:0}</style><button id=g><span id=a>one two three</span><span id=b>x</span></button><div style='width:50px'><button id=h><span id=c>one two three</span></button></div><button id=k style='display:grid;grid-template-columns:100px 1fr'><span>q</span><span>w</span></button><button id=m style='display:grid;grid-template-columns:repeat(2,1fr)'><span>q</span><span>wwwwwww</span></button>",
   "measure": [{"boxes": "#g, #h, #k, #m"}]},
  {"name": "gb-empty-and-text",
