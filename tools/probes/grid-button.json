  {"name": "gb-flex-col",
   "html": "<!DOCTYPE html><style>body{margin:0;font:16px/20px Arial}button{display:flex;height:100px;width:200px;padding:0;border:0}</style><button id=a style='flex-direction:column'><span id=a1>t</span><span id=a2>u</span></button><button id=b style='flex-direction:column;justify-content:center'><span id=b1>t</span></button><button id=c style='align-items:center'><span id=c1>t</span></button><button id=d style='flex-wrap:wrap'><span id=d1 style='width:150px'>t</span><span id=d2 style='width:150px'>u</span></button><button id=e style='flex-wrap:wrap;align-content:center'><span id=e1 style='width:150px'>t</span><span id=e2 style='width:150px'>u</span></button>",
